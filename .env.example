# Copy this file to .env before running Docker Compose.
#
# Generate a stable master key:
#   openssl rand -base64 32
#
# Keep this value safe. Losing it makes encrypted provider credentials
# unrecoverable after a data-volume reset.
KEIROUTER_MASTER_KEY=

# Host port exposed by Docker Compose.
KEIROUTER_PORT=20180

# Set to true only for local-only containers. VPS/Coolify usually needs false
# because reverse proxies connect from outside the container loopback interface.
KEIROUTER_BIND_LOOPBACK_ONLY=false

# json is recommended for containers; text is nicer for local terminals.
KEIROUTER_LOG_FORMAT=json

# Only needed when using deploy/compose.postgres.yaml.
POSTGRES_PASSWORD=

# Set true to add local/LAN OpenAI-compatible endpoints such as vLLM,
# Ollama, LM Studio, or another host on 172.16/12, 192.168/16, or 10/8.
KEIROUTER_SECURITY__ALLOW_PRIVATE_BASE_URL=false

# Controls whether KeiRouter trusts X-Forwarded-Proto / Forwarded headers when
# deciding the Secure flag on the dashboard session cookie. Default (true) is
# correct behind a TLS-terminating reverse proxy (nginx/Caddy/Traefik),
# Tailscale Funnel, or Cloudflare Tunnel. Set false to ignore forwarded headers
# and base the flag only on direct TLS connections (see issue #56).
KEIROUTER_TRUST_FORWARDED_HEADERS=true

# Portal Google SSO. Client secret belongs in the environment, not config.yaml.
# Compose maps these into the container, so keep the GOOGLE_* names below
# (compose.localhost.yaml reads ${GOOGLE_CLIENT_ID} / ${GOOGLE_CLIENT_SECRET}).
KEIROUTER_PORTAL_SSO__ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Google Cloud Console (OAuth client: Web application) — daftarkan per-domain.
# Saat redeploy ke domain berbeda, perbarui lagi di Console:
#   Authorized redirect URIs     : https://<domain>/portal/auth/google/callback
#   Authorized JavaScript origins : https://<domain>
# Harus persis (skema + host + path, tanpa trailing slash). Redirect URI =
# <public-base-url>/portal/auth/google/callback, atau nilai redirect_url di
# config.yaml bila diisi.

# SumoPod payment gateway (portal top-up). Set ENABLED=true only after the
# API key below is filled; the server refuses to start if enabled without it.
KEIROUTER_PAYMENT__ENABLED=false
# SumoPod base URL. Sandbox (default) = https://api-pay-sandbox.sumopod.com
# Production = https://api-pay.sumopod.com
KEIROUTER_PAYMENT__BASE_URL=https://api-pay-sandbox.sumopod.com
KEIROUTER_PAYMENT__API_KEY=
# Webhook auth: configure either the Svix HMAC secret, the shared token, or
# both (when both are set, a delivery must satisfy both). Empty -> webhook 503.
KEIROUTER_PAYMENT__WEBHOOK_SECRET=
KEIROUTER_PAYMENT__WEBHOOK_TOKEN=

# Cloudflare Turnstile bot protection. SITE_KEY is public (exposed to the
# browser); SECRET_KEY belongs in the environment, never config.yaml.
KEIROUTER_TURNSTILE__ENABLED=false
KEIROUTER_TURNSTILE__SITE_KEY=
KEIROUTER_TURNSTILE__SECRET_KEY=
